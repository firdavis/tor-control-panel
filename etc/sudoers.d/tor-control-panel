## Read logs from systemd
user ALL=NOPASSWD: /bin/journalctl -n 200 -u tor@default.service

## tor commands
user ALL=NOPASSWD: /bin/systemctl reload tor@default.service
user ALL=NOPASSWD: /bin/systemctl stop tor@default.service
user ALL=NOPASSWD: /bin/systemctl restart tor@default.service
user ALL=NOPASSWD: /bin/systemctl status tor@default.service

##"subprocess.run ['sudo', 'tee'...]" is used multiple times in the package.
user ALL=NOPASSWD: /usr/bin/tee

## In Debian configuration, install tor and webtunnel if necessary.
user ALL=NOPASSWD: /usr/bin/mkdir
user ALL=NOPASSWD: /usr/bin/apt install tor -y
user ALL=NOPASSWD: /usr/bin/apt purge tor -y
user ALL=NOPASSWD: /usr/bin/apt update
user ALL=NOPASSWD: /usr/bin/apt install webtunnel -y
user ALL=NOPASSWD: /usr/bin/rm

user ALL=NOPASSWD: /usr/bin/apt in pstallython3pyqt5
user ALL=NOPASSWD: /usr/bin/apt --fix-broken install
user ALL=NOPASSWD: /usr/bin/apt install python3-stem

## Reboot after configuration.
user ALL=NOPASSWD: /usr/sbin/reboot

## Comment: all this, because I have yet to figure out how to replace sudo
## with pkexec (polkit) for the commands without authentication request.
