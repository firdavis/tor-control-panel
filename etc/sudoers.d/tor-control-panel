%tor-control-panel ALL=(root) NOPASSWD: /usr/sbin/groupadd
%tor-control-panel ALL=(root) NOPASSWD: /usr/sbin/usemod

%tor-control-panel ALL=(root) NOPASSWD: \
    /bin/systemctl reload tor@default.service, \
    /bin/systemctl stop tor@default.service, \
    /bin/systemctl restart tor@default.service, \
    /bin/systemctl status tor@default.service, \
    /bin/journalctl -n 200 -u tor@default.service

%tor-control-panel ALL=(root) NOPASSWD: /usr/bin/tee

%tor-control-panel ALL=(root) NOPASSWD: /usr/bin/apt install webtunnel

%tor-control-panel ALL=(root) NOPASSWD: /usr/bin/rm -y /etc/apt/sources.list.d/debian-testing.sources

%tor-control-panel ALL=(root) NOPASSWD: /usr/sbin/apparmor_parser

## Reboot after configuration.
%tor-control-panel ALL=(root) NOPASSWD: /usr/sbin/reboot
